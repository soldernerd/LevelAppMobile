<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <!-- play flavor only. The self-updater (and with it the open_filex plugin)
         is compiled out of this build, but plugin manifests merge into every
         flavor: without these removals the Play build would declare storage and
         media-read permissions and a FileProvider it never uses, which Play
         flags and which contradicts the "collects no data" listing. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" tools:node="remove" />

    <application>
        <provider
            android:name="com.crazecoder.openfile.FileProvider"
            tools:node="remove" />
    </application>
</manifest>
